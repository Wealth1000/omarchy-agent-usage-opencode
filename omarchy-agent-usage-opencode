#!/usr/bin/python3
# omarchy:summary=Print the OpenCode usage record as JSON
# omarchy:args=[--force] [--limits-only]
# omarchy:hidden=true
"""Collect OpenCode usage into one display-ready JSON record.

Reads per-message token counts from the OpenCode SQLite database at
~/.local/share/opencode/opencode.db and aggregates them into the same
schema the agents panel expects: today's prompts and sessions, a
seven-day token chart, and an all-time breakdown by model. The panel
discovers this record automatically once the script is on PATH; no
plugin or config changes are needed.

OpenCode has no public rate-limit or billing API, so limits and balance
are always absent and the panel hides those sections automatically.
"""

from __future__ import annotations

import argparse
import fcntl
import hashlib
import json
import os
import sqlite3
import sys
import tempfile
import time
from datetime import datetime, timezone
from pathlib import Path
from typing import Any

AGENT_ID = "opencode"
AGENT_NAME = "OpenCode"


# ------------------------------------------------------------------ paths


def db_path() -> Path:
    xdg = os.environ.get("XDG_DATA_HOME")
    if xdg:
        candidate = Path(xdg) / "opencode" / "opencode.db"
        if candidate.is_file():
            return candidate
    return Path.home() / ".local" / "share" / "opencode" / "opencode.db"


def cache_root() -> Path:
    root = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "omarchy" / "agent-usage"
    root.mkdir(parents=True, exist_ok=True)
    return root


def date_string(value: datetime) -> str:
    return value.strftime("%Y-%m-%d")


def recent_date_strings() -> list[str]:
    today = datetime.now().date()
    return [(today - __import__("datetime").timedelta(days=offset)).strftime("%Y-%m-%d") for offset in range(6, -1, -1)]


def local_date_string() -> str:
    return datetime.now().strftime("%Y-%m-%d")


# ------------------------------------------------------------------ helpers


def number(value: Any) -> int:
    try:
        n = float(value or 0)
        return round(n) if n == n else 0
    except Exception:
        return 0


def empty_bucket() -> dict[str, int]:
    return {
        "inputTokens": 0,
        "outputTokens": 0,
        "cacheReadInputTokens": 0,
        "cacheCreationInputTokens": 0,
    }


def message_date(raw_timestamp_ms: Any) -> str:
    """Convert a Unix-milliseconds timestamp to a YYYY-MM-DD date string."""
    if raw_timestamp_ms is None:
        return local_date_string()
    try:
        ms = float(raw_timestamp_ms)
        if ms <= 0:
            return local_date_string()
        # Guard against second-scale timestamps (pre-2001 or post-2286).
        if ms > 1_000_000_000_000:
            seconds = ms / 1000.0
        elif ms < 10_000_000_000:
            seconds = ms
        else:
            seconds = ms / 1000.0
        return datetime.fromtimestamp(seconds, tz=timezone.utc).strftime("%Y-%m-%d")
    except Exception:
        return local_date_string()


# ------------------------------------------------------------------ scan


def scan_opencode(db: Path, max_age_seconds: float) -> dict[str, Any] | None:
    if not db.is_file():
        return None

    digest = hashlib.sha1(str(db.resolve()).encode("utf-8")).hexdigest()[:16]
    cache_file = cache_root() / f"opencode-scan-{digest}.json"
    lock_file = cache_root() / f"opencode-scan-{digest}.lock"

    cached = read_fresh_json(cache_file, max_age_seconds)
    if cached is not None:
        return cached.get("stats")

    with lock_file.open("w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        cached = read_fresh_json(cache_file, max_age_seconds)
        if cached is not None:
            return cached.get("stats")
        stats = _do_scan(db)
        write_json(cache_file, {"stats": stats})
        return stats


def _do_scan(db: Path) -> dict[str, Any]:
    today = local_date_string()
    recent_dates = recent_date_strings()
    recent: dict[str, dict[str, Any]] = {day: {"date": day, "messageCount": 0} for day in recent_dates}

    sessions: set[str] = set()
    active_days: set[str] = set()
    today_sessions: set[str] = set()
    today_tokens_by_model: dict[str, int] = {}
    usage_by_model: dict[str, dict[str, int]] = {}
    prompts = 0
    today_prompt_count = 0
    today_token_total = 0

    # Opencode may be writing right now; a read-only connection with a short
    # timeout is enough — SQLite's read-write locking means readers wait for
    # writers but never conflict. If we can't get in, the cache saves us.
    try:
        conn = sqlite3.connect(db.resolve().as_uri() + "?mode=ro", uri=True, timeout=2)
    except sqlite3.Error:
        return _empty_stats()
    try:
        conn.execute("PRAGMA query_only = ON")
        rows = conn.execute(
            """
            SELECT session_id, seq, time_created, data
            FROM session_message
            WHERE json_extract(data, '$.tokens') IS NOT NULL
            ORDER BY time_created
            """
        )

        for session_id, seq, time_created_ms, raw_data in rows:
            try:
                entry = json.loads(raw_data)
                if not isinstance(entry, dict):
                    continue

                tokens = entry.get("tokens")
                if not isinstance(tokens, dict):
                    continue

                input_t = number(tokens.get("input"))
                output_t = number(tokens.get("output"))
                reasoning_t = number(tokens.get("reasoning"))
                # Opencode groups reasoning into output; treat it as output.
                output_t += reasoning_t
                cache = tokens.get("cache") or {}
                cache_read = number(cache.get("read"))
                cache_write = number(cache.get("write"))

                total = input_t + output_t + cache_read + cache_write
                if total <= 0:
                    continue

                day = message_date(time_created_ms)
                model = str(entry.get("model", {}).get("id") or "opencode").rstrip("/").split("/")[-1]
                session_key = f"opencode:{session_id}:{seq}"

            except Exception:
                continue

            sessions.add(session_key)
            active_days.add(day)
            prompts += 1

            bucket = usage_by_model.setdefault(model, empty_bucket())
            bucket["inputTokens"] += input_t
            bucket["outputTokens"] += output_t
            bucket["cacheReadInputTokens"] += cache_read
            bucket["cacheCreationInputTokens"] += cache_write

            if day in recent:
                recent[day]["messageCount"] += total

            if day == today:
                today_prompt_count += 1
                today_sessions.add(session_key)
                today_token_total += total
                today_tokens_by_model[model] = today_tokens_by_model.get(model, 0) + total

    except sqlite3.Error:
        return _empty_stats()
    finally:
        if conn:
            conn.close()

    if prompts == 0:
        return _empty_stats()

    return {
        "todayPrompts": today_prompt_count,
        "todaySessions": len(today_sessions),
        "todayTotalTokens": today_token_total,
        "todayTokensByModel": today_tokens_by_model,
        "recentDays": [recent[day] for day in recent_dates],
        "modelUsage": usage_by_model,
        "totalPrompts": prompts,
        "totalSessions": len(sessions),
        "activeDays": len(active_days),
        "activeDates": sorted(active_days),
    }


def _empty_stats() -> dict[str, Any]:
    return {
        "todayPrompts": 0,
        "todaySessions": 0,
        "todayTotalTokens": 0,
        "todayTokensByModel": {},
        "recentDays": [],
        "modelUsage": {},
        "totalPrompts": 0,
        "totalSessions": 0,
        "activeDays": 0,
        "activeDates": [],
    }


# ------------------------------------------------------------------ cache


def read_fresh_json(path: Path, max_age_seconds: float) -> dict[str, Any] | None:
    if max_age_seconds <= 0 or not path.exists():
        return None
    try:
        if time.time() - path.stat().st_mtime <= max_age_seconds:
            return json.loads(path.read_text(encoding="utf-8"))
    except Exception:
        return None
    return None


def write_json(path: Path, payload: dict[str, Any]) -> None:
    handle_fd, tmp_name = tempfile.mkstemp(dir=path.parent, prefix=path.name + ".", suffix=".tmp")
    tmp = Path(tmp_name)
    try:
        with os.fdopen(handle_fd, "w", encoding="utf-8") as handle:
            handle.write(json.dumps(payload, separators=(",", ":"), sort_keys=True) + "\n")
        tmp.chmod(0o644)
        tmp.replace(path)
    except BaseException:
        tmp.unlink(missing_ok=True)
        raise


# -------------------------------------------------------------------- record


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--force", action="store_true", help="rescan the database, ignoring caches")
    parser.add_argument("--limits-only", action="store_true", help="reuse any recent scan; no limits to fetch")
    parser.add_argument("--cache-seconds", type=float, default=20)
    args = parser.parse_args()

    db = db_path()
    scan_age = 0 if args.force else (900 if args.limits_only else args.cache_seconds)
    stats = scan_opencode(db, scan_age) or _empty_stats()

    ready = number(stats.get("totalPrompts")) > 0 or number(stats.get("todayPrompts")) > 0

    record = {
        "schemaVersion": 1,
        "id": AGENT_ID,
        "name": AGENT_NAME,
        "updatedAt": datetime.now(timezone.utc).isoformat(),
        "ready": ready,
        "hasLocalStats": True,
        "tierLabel": "",
        "usageStatusText": "",
        "authHelpText": "",
        "limits": [],
    }
    record.update(stats)
    print(json.dumps(record, separators=(",", ":"), sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
